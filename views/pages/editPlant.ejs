<% layout('layouts/boilerplate.ejs')-%>

<body>
    <div class="row">
        <div class="col-8 offset-2">
    <form enctype="multipart/form-data" class="needs-validation", novalidate method="POST", action="/plant/<%= plant._id%>/edit?_method=patch">
        <label for="name" class="form-label">Name</label>
        <input id="name" name="Plant[name]" class="form-control" value='<%=plant.name%>' required>
        <div class="invalid-feedback mb-3">
       Please enter Name
      </div>
        <label for="desc" class="form-label">Description</label>
        <textarea id="desc" name="Plant[desc]" class="form-control"  required><%=plant.desc%></textarea>
        <div class="invalid-feedback mb-3">
       Please enter Description
      </div>
        <label for="image" class="form-label">Upload new Image or leave empty</label>
        <input id="image" name="Plant[image]" class="form-control mb-3" type="file"  placeholder="If you want to change the picture also then upload new picture here">
        <button class="btn btn-primary" type="submit">Submit</button>
    </form>
    </div>
    </div>
</body>